{
  "name": "anz",
  "displayName": "anz",
  "publisher": "bogduto",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "properties": {
        "anz.backupInterval": {
          "type": "number",
          "default": 300000,
          "description": "Interval in milliseconds for automatic backup. Default is 5 minutes (300000 ms)."
        },
        "anz.ignoreFileMinDuration": {
          "type": "number",
          "default": 300000,
          "description": "Minimum duration in milliseconds for which a file must be open before it's backed up. If less than this value, the file won't be written to the system. Default is 5 minutes (300000 ms)."
        },
        "anz.afkIntervalTime": {
          "type": "number",
          "default": 300000,
          "description": "Interval in milliseconds to consider the user AFK (away from keyboard). Default is 5 minutes (300000 ms)."
        }
      }
    },
    "commands": [
      {
        "command": "anz.LOGIN",
        "title": "Login to Anz"
      },
      {
        "command": "anz.LOGOUT",
        "title": "Logout from Anz"
      },
      {
        "command": "anz.CHECK_AUTH",
        "title": "Check Anz authentication status"
      },
      {
        "command": "anz.START",
        "title": "Start timer"
      },
      {
        "command": "anz.RESET",
        "title": "Reset timer"
      },
      {
        "command": "anz.STOP",
        "title": "Stop timer"
      },
      {
        "command": "anz.MENU",
        "title": "Menu actions"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2"
  }
}
